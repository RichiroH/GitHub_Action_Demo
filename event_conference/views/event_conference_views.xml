<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_event_conference_list" model="ir.ui.view">
        <field name="name">event.conference.list</field>
        <field name="model">event.conference</field>
        <field name="arch" type="xml">
            <list string="Conferences" decoration-info="state=='draft'" decoration-success="state=='confirmed'">
                <field name="name"/>
                <field name="organizer_id"/>
                <field name="date_begin"/>
                <field name="location"/>
                <field name="capacity"/>
                <field name="seats_taken"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_event_conference_form" model="ir.ui.view">
        <field name="name">event.conference.form</field>
        <field name="model">event.conference</field>
        <field name="arch" type="xml">
            <form string="Conference">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done" string="Mark Done" type="object" class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_draft" string="Reset to Draft" type="object" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="organizer_id"/>
                            <field name="location"/>
                        </group>
                        <group>
                            <field name="date_begin"/>
                            <field name="date_end"/>
                            <field name="capacity"/>
                            <field name="seats_taken"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sessions">
                            <field name="session_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="speaker_id"/>
                                    <field name="start_datetime"/>
                                    <field name="duration"/>
                                    <field name="seats_available"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_event_conference_search" model="ir.ui.view">
        <field name="name">event.conference.search</field>
        <field name="model">event.conference</field>
        <field name="arch" type="xml">
            <search string="Search Conferences">
                <field name="name"/>
                <field name="location"/>
                <field name="organizer_id"/>
                <filter string="Confirmed" name="confirmed" domain="[('state','=','confirmed')]"/>
                <group expand="0" string="Group By">
                    <filter string="State" name="state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_event_conference" model="ir.actions.act_window">
        <field name="name">Conferences</field>
        <field name="res_model">event.conference</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new conference
            </p>
        </field>
    </record>

    <menuitem id="menu_event_root" name="Conferences" web_icon="event_conference,static/description/icon.png"/>
    <menuitem id="menu_event_conferences" name="Conferences" parent="menu_event_root" action="action_event_conference"/>
</odoo>
