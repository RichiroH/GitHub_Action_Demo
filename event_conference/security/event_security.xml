<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_event_organizer" model="res.groups">
            <field name="name">Event Organizer</field>
            <field name="category_id" ref="base.module_category_events"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="group_event_manager" model="res.groups">
            <field name="name">Event Manager</field>
            <field name="category_id" ref="base.module_category_events"/>
            <field name="implied_ids" eval="[(4, ref('group_event_organizer'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
