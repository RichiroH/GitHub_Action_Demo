<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_library_book_list" model="ir.ui.view">
        <field name="name">library.book.list</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <list string="Books">
                <field name="title"/>
                <field name="author_id"/>
                <field name="isbn"/>
                <field name="genre"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_library_book_form" model="ir.ui.view">
        <field name="name">library.book.form</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form string="Book">
                <header>
                    <button name="action_borrow" string="Borrow" type="object" class="btn-primary" invisible="state != 'available'"/>
                    <button name="action_return" string="Return" type="object" class="btn-primary" invisible="state != 'borrowed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="available,borrowed,lost"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="title"/>
                            <field name="isbn"/>
                            <field name="author_id"/>
                            <field name="publisher_id"/>
                            <field name="publish_date"/>
                        </group>
                        <group>
                            <field name="genre"/>
                            <field name="pages"/>
                            <field name="price"/>
                            <field name="currency_id"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Synopsis">
                            <field name="synopsis"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_library_book_search" model="ir.ui.view">
        <field name="name">library.book.search</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <search string="Search Books">
                <field name="title"/>
                <field name="isbn"/>
                <field name="author_id"/>
                <filter string="Available" name="available" domain="[('state','=','available')]"/>
                <filter string="Borrowed" name="borrowed" domain="[('state','=','borrowed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Genre" name="genre" context="{'group_by': 'genre'}"/>
                    <filter string="Author" name="author" context="{'group_by': 'author_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_library_book" model="ir.actions.act_window">
        <field name="name">Books</field>
        <field name="res_model">library.book</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first book to the catalog
            </p>
        </field>
    </record>

    <menuitem id="menu_library_root" name="Library" web_icon="library_book,static/description/icon.png"/>
    <menuitem id="menu_library_books" name="Books" parent="menu_library_root" action="action_library_book"/>
</odoo>
