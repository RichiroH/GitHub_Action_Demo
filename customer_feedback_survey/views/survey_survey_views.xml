<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_feedback_survey_list" model="ir.ui.view">
        <field name="name">feedback.survey.list</field>
        <field name="model">feedback.survey</field>
        <field name="arch" type="xml">
            <list string="Surveys">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="answer_count"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_feedback_survey_form" model="ir.ui.view">
        <field name="name">feedback.survey.form</field>
        <field name="model">feedback.survey</field>
        <field name="arch" type="xml">
            <form string="Survey">
                <header>
                    <button name="action_open" string="Open" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_close" string="Close" type="object" class="btn-secondary" invisible="state != 'open'"/>
                    <button name="action_open_summary_wizard" string="Summary" type="object" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,closed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="date_open"/>
                            <field name="date_closed"/>
                            <field name="answer_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Questions">
                            <field name="question_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="question_type"/>
                                    <field name="required"/>
                                </list>
                            </field>
                        </page>
                        <page string="Answers">
                            <field name="answer_ids">
                                <list>
                                    <field name="question_id"/>
                                    <field name="partner_id"/>
                                    <field name="text_value"/>
                                    <field name="star_value"/>
                                    <field name="boolean_value"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_feedback_survey_search" model="ir.ui.view">
        <field name="name">feedback.survey.search</field>
        <field name="model">feedback.survey</field>
        <field name="arch" type="xml">
            <search string="Search Surveys">
                <field name="name"/>
                <field name="partner_id"/>
                <filter string="Open" name="open" domain="[('state','=','open')]"/>
                <filter string="Closed" name="closed" domain="[('state','=','closed')]"/>
            </search>
        </field>
    </record>

    <record id="action_feedback_survey" model="ir.actions.act_window">
        <field name="name">Surveys</field>
        <field name="res_model">feedback.survey</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new customer feedback survey
            </p>
        </field>
    </record>

    <menuitem id="menu_survey_root" name="Feedback" web_icon="customer_feedback_survey,static/description/icon.png"/>
    <menuitem id="menu_survey_surveys" name="Surveys" parent="menu_survey_root" action="action_feedback_survey"/>
</odoo>
