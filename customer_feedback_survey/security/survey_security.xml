<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_survey_respondent" model="res.groups">
            <field name="name">Survey Respondent</field>
            <field name="category_id" ref="base.module_category_marketing_surveys"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="group_survey_manager" model="res.groups">
            <field name="name">Survey Manager</field>
            <field name="category_id" ref="base.module_category_marketing_surveys"/>
            <field name="implied_ids" eval="[(4, ref('group_survey_respondent'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
