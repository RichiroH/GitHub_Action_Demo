<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_survey_summary_wizard_form" model="ir.ui.view">
        <field name="name">survey.summary.wizard.form</field>
        <field name="model">survey.summary.wizard</field>
        <field name="arch" type="xml">
            <form string="Survey Summary">
                <group>
                    <field name="survey_id"/>
                    <field name="summary"/>
                </group>
                <footer>
                    <button name="action_generate" string="Generate" type="object" class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
