<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_warehouse_bin_list" model="ir.ui.view">
        <field name="name">warehouse.bin.list</field>
        <field name="model">warehouse.bin</field>
        <field name="arch" type="xml">
            <list string="Bins" decoration-success="is_empty" decoration-warning="state=='maintenance'">
                <field name="code"/>
                <field name="barcode"/>
                <field name="zone_id"/>
                <field name="capacity"/>
                <field name="occupied"/>
                <field name="free_space"/>
                <field name="is_empty" column_invisible="True"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_warehouse_bin_form" model="ir.ui.view">
        <field name="name">warehouse.bin.form</field>
        <field name="model">warehouse.bin</field>
        <field name="arch" type="xml">
            <form string="Bin">
                <header>
                    <button name="action_lock" string="Lock" type="object" class="btn-secondary" invisible="state == 'locked'"/>
                    <button name="action_unlock" string="Unlock" type="object" class="btn-primary" invisible="state != 'locked'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="barcode"/>
                            <field name="zone_id"/>
                        </group>
                        <group>
                            <field name="capacity"/>
                            <field name="occupied"/>
                            <field name="free_space"/>
                            <field name="is_empty"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_warehouse_bin_search" model="ir.ui.view">
        <field name="name">warehouse.bin.search</field>
        <field name="model">warehouse.bin</field>
        <field name="arch" type="xml">
            <search string="Search Bins">
                <field name="code"/>
                <field name="barcode"/>
                <field name="zone_id"/>
                <filter string="Empty" name="empty" domain="[('is_empty','=',True)]"/>
                <filter string="Locked" name="locked" domain="[('state','=','locked')]"/>
                <group expand="0" string="Group By">
                    <filter string="Zone" name="zone" context="{'group_by': 'zone_id'}"/>
                    <filter string="State" name="state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_warehouse_bin" model="ir.actions.act_window">
        <field name="name">Bins</field>
        <field name="res_model">warehouse.bin</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new bin location
            </p>
        </field>
    </record>

    <menuitem id="menu_warehouse_bins" name="Bins" parent="menu_warehouse_root" action="action_warehouse_bin"/>
</odoo>
