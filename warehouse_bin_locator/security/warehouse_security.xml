<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_warehouse_worker" model="res.groups">
            <field name="name">Warehouse Worker</field>
            <field name="category_id" ref="base.module_category_inventory_warehouse"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="group_warehouse_manager" model="res.groups">
            <field name="name">Warehouse Manager</field>
            <field name="category_id" ref="base.module_category_inventory_warehouse"/>
            <field name="implied_ids" eval="[(4, ref('group_warehouse_worker'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
