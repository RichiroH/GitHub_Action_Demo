<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_hr_training_enrollment_list" model="ir.ui.view">
        <field name="name">hr.training.enrollment.list</field>
        <field name="model">hr.training.enrollment</field>
        <field name="arch" type="xml">
            <list string="Enrollments">
                <field name="course_id"/>
                <field name="attendee_id"/>
                <field name="date_start"/>
                <field name="score"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_hr_training_enrollment_form" model="ir.ui.view">
        <field name="name">hr.training.enrollment.form</field>
        <field name="model">hr.training.enrollment</field>
        <field name="arch" type="xml">
            <form string="Enrollment">
                <header>
                    <button name="action_enroll" string="Enroll" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_complete" string="Complete" type="object" class="btn-primary" invisible="state != 'enrolled'"/>
                    <button name="action_print_certificate" string="Certificate" type="object" invisible="state != 'completed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,enrolled,completed"/>
                </header>
                <sheet>
                    <group>
                        <field name="course_id"/>
                        <field name="attendee_id"/>
                        <field name="date_start"/>
                        <field name="date_end"/>
                        <field name="score"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_training_enrollment" model="ir.actions.act_window">
        <field name="name">Enrollments</field>
        <field name="res_model">hr.training.enrollment</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hr_training_enrollments" name="Enrollments" parent="menu_hr_training_root" action="action_hr_training_enrollment"/>
</odoo>
