<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_restaurant_menu_list" model="ir.ui.view">
        <field name="name">restaurant.menu.list</field>
        <field name="model">restaurant.menu</field>
        <field name="arch" type="xml">
            <list string="Menus">
                <field name="name"/>
                <field name="code"/>
                <field name="date_validity"/>
                <field name="dish_count"/>
                <field name="total_price"/>
                <field name="is_active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_restaurant_menu_form" model="ir.ui.view">
        <field name="name">restaurant.menu.form</field>
        <field name="model">restaurant.menu</field>
        <field name="arch" type="xml">
            <form string="Menu">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="date_validity"/>
                            <field name="is_active"/>
                        </group>
                        <group>
                            <field name="dish_count"/>
                            <field name="total_price"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Dishes">
                            <field name="dish_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="category"/>
                                    <field name="price"/>
                                    <field name="available"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_restaurant_menu" model="ir.actions.act_window">
        <field name="name">Menus</field>
        <field name="res_model">restaurant.menu</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_restaurant_menus" name="Menus" parent="menu_restaurant_root" action="action_restaurant_menu"/>
</odoo>
