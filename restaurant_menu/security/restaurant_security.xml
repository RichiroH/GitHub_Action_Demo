<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_restaurant_waiter" model="res.groups">
            <field name="name">Waiter</field>
            <field name="category_id" ref="base.module_category_restaurant_menu"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="group_restaurant_chef" model="res.groups">
            <field name="name">Chef</field>
            <field name="category_id" ref="base.module_category_restaurant_menu"/>
            <field name="implied_ids" eval="[(4, ref('group_restaurant_waiter'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
