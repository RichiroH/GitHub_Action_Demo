<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_fleet_driver" model="res.groups">
            <field name="name">Fleet Driver</field>
            <field name="category_id" ref="base.module_category_fleet_fleet"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="group_fleet_manager" model="res.groups">
            <field name="name">Fleet Manager</field>
            <field name="category_id" ref="base.module_category_fleet_fleet"/>
            <field name="implied_ids" eval="[(4, ref('group_fleet_driver'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
