<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_fleet_mileage_list" model="ir.ui.view">
        <field name="name">fleet.mileage.log.list</field>
        <field name="model">fleet.mileage.log</field>
        <field name="arch" type="xml">
            <list string="Mileage Logs">
                <field name="date"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="start_odometer"/>
                <field name="end_odometer"/>
                <field name="distance"/>
                <field name="purpose"/>
            </list>
        </field>
    </record>

    <record id="view_fleet_mileage_form" model="ir.ui.view">
        <field name="name">fleet.mileage.log.form</field>
        <field name="model">fleet.mileage.log</field>
        <field name="arch" type="xml">
            <form string="Mileage Log">
                <sheet>
                    <group>
                        <field name="vehicle_id"/>
                        <field name="date"/>
                        <field name="start_odometer"/>
                        <field name="end_odometer"/>
                        <field name="distance"/>
                        <field name="purpose"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fleet_mileage" model="ir.actions.act_window">
        <field name="name">Mileage Logs</field>
        <field name="res_model">fleet.mileage.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_fleet_mileage" name="Mileage Logs" parent="menu_fleet_root" action="action_fleet_mileage"/>
</odoo>
