<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_fleet_vehicle_list" model="ir.ui.view">
        <field name="name">fleet.vehicle.tracker.list</field>
        <field name="model">fleet.vehicle.tracker</field>
        <field name="arch" type="xml">
            <list string="Vehicles">
                <field name="name"/>
                <field name="license_plate"/>
                <field name="brand"/>
                <field name="model"/>
                <field name="driver_id"/>
                <field name="status" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_fleet_vehicle_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.tracker.form</field>
        <field name="model">fleet.vehicle.tracker</field>
        <field name="arch" type="xml">
            <form string="Vehicle">
                <header>
                    <button name="action_set_maintenance" string="Set Maintenance" type="object" class="btn-secondary" invisible="status == 'maintenance'"/>
                    <button name="action_set_active" string="Activate" type="object" class="btn-primary" invisible="status == 'active'"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="license_plate"/>
                            <field name="brand"/>
                            <field name="model"/>
                            <field name="year"/>
                        </group>
                        <group>
                            <field name="color"/>
                            <field name="fuel_type"/>
                            <field name="acquisition_date"/>
                            <field name="odometer"/>
                            <field name="driver_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Mileage Logs">
                            <field name="mileage_log_ids">
                                <list>
                                    <field name="date"/>
                                    <field name="distance"/>
                                    <field name="purpose"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_fleet_vehicle_search" model="ir.ui.view">
        <field name="name">fleet.vehicle.tracker.search</field>
        <field name="model">fleet.vehicle.tracker</field>
        <field name="arch" type="xml">
            <search string="Search Vehicles">
                <field name="name"/>
                <field name="license_plate"/>
                <field name="driver_id"/>
                <filter string="Active" name="active" domain="[('status','=','active')]"/>
                <filter string="In Maintenance" name="maintenance" domain="[('status','=','maintenance')]"/>
                <group expand="0" string="Group By">
                    <filter string="Fuel Type" name="fuel" context="{'group_by': 'fuel_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fleet_vehicle" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="res_model">fleet.vehicle.tracker</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register a new vehicle
            </p>
        </field>
    </record>

    <menuitem id="menu_fleet_root" name="Fleet Tracker" web_icon="fleet_vehicle_tracker,static/description/icon.png"/>
    <menuitem id="menu_fleet_vehicles" name="Vehicles" parent="menu_fleet_root" action="action_fleet_vehicle"/>
</odoo>
